{% extends 'layouts/page.njk' %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if flash %}
        {{ govukNotificationBanner({
          type: "success" if flash.success else undefined,
          titleText: "Success" if flash.success else "Update",
          text: flash.text
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">Make and publish guidance</h1>
      <p class="govuk-body">Work through the phases. You draft the guidance, then send it to others to review, approve and readiness test before you publish it.</p>

      {{ govukTaskList({ items: items }) }}

    </div>
  </div>
{% endblock %}
