{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = 'Make and publish guidance' %}
{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Make and publish guidance</h1>
      <p class="govuk-body-l">Take a piece of guidance from draft to published.</p>

      {{ govukButton({ text: "Start now", href: "/guidance/what", isStartButton: true }) }}

      <h2 class="govuk-heading-m">Who this is for</h2>
      <p class="govuk-body">People who turn policy or operational processes into published guidance. You draft it, then send it for review, approval and readiness testing.</p>

      <h2 class="govuk-heading-m">Before you start</h2>
      <p class="govuk-body">You will need:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>the policy, scheme or process your guidance is based on</li>
        <li>your draft as a Word document (.docx)</li>
        <li>a subject matter expert to approve it, and the team who will readiness test it</li>
      </ul>
    </div>
  </div>
{% endblock %}
