{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Make and publish guidance</h1>
      <p class="govuk-body-l">Take a piece of guidance from draft to published.</p>

      {{ govukButton({ text: "Start now", href: "/guidance/task-list", isStartButton: true }) }}

      <h2 class="govuk-heading-m">Who this is for</h2>
      <p class="govuk-body">Designers who turn policy into guidance. You draft it, then send it for review, approval and readiness testing.</p>

      <h2 class="govuk-heading-m">Before you start</h2>
      <p class="govuk-body">You will need:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>the policy or scheme information your guidance is based on</li>
        <li>your draft as a Word document (.docx)</li>
        <li>the reviewer, approver and Model Office team who will check it</li>
      </ul>
    </div>
  </div>
{% endblock %}
