{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Phase {{ phase.number }} of 5</span>

      {% if status == 'awaiting-approval' %}

        <h1 class="govuk-heading-l">Guide sent for subject matter expert approval</h1>
        <p class="govuk-body">You cannot edit the guide while it is being reviewed.</p>

        <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">
        <h2 class="govuk-heading-s">Prototype controls</h2>
        {{ govukInsetText({ text: "In the real service someone else decides this: a policy, technical or operational specialist. Simulate it to continue." }) }}
        <form method="post" action="/guidance/review" novalidate>
          <div class="govuk-button-group">
            {{ govukButton({ text: "Simulate: subject matter expert approves", name: "action", value: "approve", classes: "govuk-button--secondary" }) }}
            {{ govukButton({ text: "Simulate: subject matter expert sends back for amends", name: "action", value: "amends", classes: "govuk-button--secondary" }) }}
          </div>
        </form>

        <p class="govuk-body"><a class="govuk-link" href="/guidance/task-list">Return to the task list</a></p>

      {% elif status == 'amends-sme' %}

        <h1 class="govuk-heading-l">The subject matter expert sent this back for amends</h1>

        <p class="govuk-body">{{ amends.intro }} Check each one before you make it. You stay responsible for the changes.</p>

        <h2 class="govuk-heading-m">Changes {{ amends.from }} asked for</h2>
        {{ govukSummaryList({ rows: amends.rows }) }}

        <p class="govuk-body">Make the changes, then send it for review again.</p>
        <form method="post" action="/guidance/review" novalidate>
          {{ govukButton({ text: "Send for review again", name: "action", value: "send", classes: "govuk-button--secondary" }) }}
        </form>

      {% elif status == 'done' %}

        <h1 class="govuk-heading-l">The guide is approved</h1>
        <p class="govuk-body">The subject matter expert approved it. The next phase is readiness testing.</p>
        <p class="govuk-body"><a class="govuk-link" href="/guidance/task-list">Return to the task list</a></p>

      {% else %}

        <h1 class="govuk-heading-l">Check your guide is ready for review</h1>
        <p class="govuk-body">A subject matter expert checks it is accurate and approves it. You cannot edit it while it is being reviewed.</p>

        <h2 class="govuk-heading-m">Before you send it, check that:</h2>
        <ul class="govuk-list govuk-list--bullet">
          <li>it is accurate and up to date</li>
          <li>it covers the whole process, with no steps missing</li>
          <li>it is written in plain English</li>
          <li>it meets accessibility standards</li>
        </ul>

        <form method="post" action="/guidance/review" novalidate>
          <div class="govuk-button-group">
            {{ govukButton({ text: "Send for review", name: "action", value: "send" }) }}
            <a class="govuk-link" href="/guidance/sections">Go back and edit the guide</a>
          </div>
        </form>

      {% endif %}
    </div>
  </div>
{% endblock %}
