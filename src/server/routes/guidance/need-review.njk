{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">Phase {{ phase.number }} of 5</span>

      {% if fromAi %}
        <h1 class="govuk-heading-l">Check what AI found in your documents</h1>
        <p class="govuk-body">AI read your documents and drafted the details below.</p>
        <p class="govuk-body">It can get this wrong, so check each one. You are responsible for what you publish.</p>
      {% else %}
        <h1 class="govuk-heading-l">Check the details</h1>
        <p class="govuk-body">Check the details below, then confirm them.</p>
      {% endif %}

      {{ govukSummaryList({ rows: rows }) }}

      <form method="post" action="/guidance/need/review" novalidate>
        {{ govukButton({ text: "Accept and continue" }) }}
      </form>

      {% if fromAi %}
        <p class="govuk-body"><a class="govuk-link" href="/guidance/need/restart">Start again without the documents</a></p>
      {% endif %}

    </div>
  </div>
{% endblock %}
