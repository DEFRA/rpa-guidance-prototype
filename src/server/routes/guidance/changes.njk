{% extends 'layouts/page.njk' %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">Phase {{ phase.number }} of 5</span>
      <h1 class="govuk-heading-l">What has changed</h1>

      {% if editGuide %}
        <p class="govuk-body">Your edits to <strong>{{ editGuide.title }}</strong>, shown against the published version. Removed text is red, added text is green.</p>
      {% endif %}

      {% if changed %}
        <div class="app-diff">
          {{ diffHtml | safe }}
        </div>
      {% else %}
        {{ govukInsetText({ text: "You have not changed anything yet. Edit a section, then come back to see the difference against the published version." }) }}
      {% endif %}

      <p class="govuk-body govuk-!-margin-top-4">
        <a class="govuk-link" href="/guidance/review">Back to review</a>
      </p>

    </div>
  </div>
{% endblock %}
