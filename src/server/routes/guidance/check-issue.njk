{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">{{ finding.sectionLabel }}</span>
      <h1 class="govuk-heading-l">{{ finding.issue }}</h1>

      <p class="govuk-!-margin-bottom-4">
        {% if decision == 'approved' %}
          {{ govukTag({ text: "Approved", classes: "govuk-tag--green" }) }}
        {% elif decision == 'rejected' %}
          {{ govukTag({ text: "Rejected", classes: "govuk-tag--grey" }) }}
        {% else %}
          {{ govukTag({ text: "To review", classes: "govuk-tag--red" if finding.mustFix else "govuk-tag--blue" }) }}
        {% endif %}
      </p>

      <p class="govuk-body">{% if finding.mustFix %}You must review this before publishing.{% else %}This is a suggested improvement.{% endif %}</p>

      <h2 class="govuk-heading-s">Why it matters</h2>
      <p class="govuk-body">{{ finding.why_it_matters }}</p>

      <h2 class="govuk-heading-s">Suggested rewrite</h2>
      <p class="govuk-body">{{ finding.recommendation }}</p>

      {% if finding.suggestion %}
        <div class="app-rewrite">
          <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Current</p>
          <p class="app-rewrite__before">{{ finding.suggestion.before }}</p>
          <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Suggested</p>
          <p class="app-rewrite__after">{{ finding.suggestion.after }}</p>
        </div>
      {% endif %}

      <form method="post" action="/guidance/check/issues/{{ issueIndex }}" novalidate>
        <div class="govuk-button-group">
          {% if decision == 'approved' %}
            {{ govukButton({ text: "Reject instead", name: "decision", value: "rejected", classes: "govuk-button--secondary" }) }}
          {% elif decision == 'rejected' %}
            {{ govukButton({ text: "Approve instead", name: "decision", value: "approved" }) }}
          {% else %}
            {{ govukButton({ text: "Approve suggestion", name: "decision", value: "approved" }) }}
            {{ govukButton({ text: "Reject", name: "decision", value: "rejected", classes: "govuk-button--secondary" }) }}
          {% endif %}
        </div>
      </form>

      <p class="govuk-body">
        <a class="govuk-link" href="/guidance/check">Back to all issues</a>
      </p>

    </div>
  </div>
{% endblock %}
