{% extends 'layouts/page.njk' %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">Published guide</span>
      <h1 class="govuk-heading-l">{{ guideTitle }}</h1>
      <p class="govuk-body-s app-published-meta">This is the published guide, as caseworkers and processors read it on the Guidance Hub.</p>

      <div class="app-rich-text">
        {{ guideHtml | safe }}
      </div>

    </div>
  </div>
{% endblock %}
