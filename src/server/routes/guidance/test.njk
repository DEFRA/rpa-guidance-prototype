{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set page = 'guidance' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Phase {{ phase.number }} of 5</span>

      {% if status == 'awaiting-readiness' %}

        <h1 class="govuk-heading-l">Guide sent for readiness testing</h1>
        <p class="govuk-body">The Model Office team runs it against your scenarios, then passes it or sends back what failed.</p>

        <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">
        <h2 class="govuk-heading-s">Prototype controls</h2>
        {{ govukInsetText({ text: "In the real service the Model Office team is a different group. Simulate their result here to continue the prototype." }) }}
        <form method="post" action="/guidance/test" novalidate>
          <div class="govuk-button-group">
            {{ govukButton({ text: "Simulate: Model Office passes it", name: "action", value: "pass", classes: "govuk-button--secondary" }) }}
            {{ govukButton({ text: "Simulate: Model Office finds issues", name: "action", value: "issues", classes: "govuk-button--secondary" }) }}
          </div>
        </form>

        <p class="govuk-body"><a class="govuk-link" href="/guidance/task-list">Return to the task list</a></p>

      {% elif status == 'issues' %}

        <h1 class="govuk-heading-l">The Model Office team found issues</h1>
        {{ govukInsetText({ text: "Two scenarios failed: a processor could not tell which hold code to apply when escalating, and the split and merge example was unclear." }) }}
        <p class="govuk-body">Make the changes, then send it for testing again.</p>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Edit the guide", href: "/guidance/sections" }) }}
        </div>
        <form method="post" action="/guidance/test" novalidate>
          {{ govukButton({ text: "Send for testing again", name: "action", value: "send", classes: "govuk-button--secondary" }) }}
        </form>

      {% elif status == 'done' %}

        <h1 class="govuk-heading-l">Readiness testing passed</h1>
        <p class="govuk-body">The Model Office team passed the guide. The next phase is the pre-publish check.</p>
        <p class="govuk-body"><a class="govuk-link" href="/guidance/task-list">Return to the task list</a></p>

      {% else %}

        <h1 class="govuk-heading-l">Test scenarios for readiness testing</h1>
        <p class="govuk-body">AI suggested these from your guide. The Model Office team will test the guide against them.</p>

        {{ govukInsetText({ text: "Review the suggested scenarios. Change or remove any, and add any that are missing, before you send them." }) }}

        {{ govukSummaryList({ rows: scenarioRows }) }}

        {{ govukButton({ text: "Add another scenario", href: "/guidance/test/scenario/new", classes: "govuk-button--secondary" }) }}

        <form method="post" action="/guidance/test" novalidate>
          {{ govukButton({ text: "Send for readiness testing", name: "action", value: "send" }) }}
        </form>

      {% endif %}
    </div>
  </div>
{% endblock %}
