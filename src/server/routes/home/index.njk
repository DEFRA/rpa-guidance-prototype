{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set page = 'home' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Make and publish RPA guidance</h1>

      <p class="govuk-body">Turn a policy or process into guidance and publish it to the Guidance Hub.</p>

      {{ govukButton({ text: "Start now", href: "/guidance/what", isStartButton: true }) }}

      <h2 class="govuk-heading-m">What this service does</h2>
      <p class="govuk-body">It takes you through drafting, review, approval and readiness testing. Before you publish, an AI check flags problems that would stop the guidance going live.</p>

      <h2 class="govuk-heading-m">Before you start</h2>
      <p class="govuk-body">You'll need:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>the policy, scheme or process the guidance is based on</li>
        <li>your draft as a Word document (.docx)</li>
        <li>to know who will approve the guidance and who will readiness test it</li>
      </ul>
    </div>
  </div>
{% endblock %}
