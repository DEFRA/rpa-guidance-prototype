{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: "Call logged",
        html: "Reference<br><strong>" + reference + "</strong>"
      }) }}

      {% if rows | length %}
        <h2 class="govuk-heading-m">What you logged</h2>
        {{ govukSummaryList({ rows: rows }) }}
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="/demand/ask">Answer another query</a>
      </p>
    </div>
  </div>
{% endblock %}
