{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Accessibility statement</h1>

      <p class="govuk-body">This is a prototype built to test ideas for making, finding and using RPA guidance. It is not a live service.</p>

      <p class="govuk-body">It is built with the GOV.UK Design System, which aims to meet level AA of the Web Content Accessibility Guidelines (WCAG) 2.2. As a prototype, it has not yet had a full accessibility audit, so some parts may not meet that standard.</p>

      <h2 class="govuk-heading-m">Reporting accessibility problems</h2>
      <p class="govuk-body">If you find a problem, contact the AI Capability and Enablement team at <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk">AICapabilityAndEnablement@defra.gov.uk</a>.</p>
    </div>
  </div>
{% endblock %}
