{% extends 'layouts/page.njk' %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [ { text: errorMessage, href: "#applicant" } ]
        }) }}
      {% endif %}

      <form action="/find-funding/about-you" method="post" novalidate>
        {{ govukRadios({
          name: "applicant",
          idPrefix: "applicant",
          fieldset: {
            legend: {
              text: "Who are you applying as?",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          errorMessage: { text: errorMessage } if errorMessage,
          items: [
            { value: "farmer", text: "A farmer or land manager", checked: applicant == "farmer" },
            { value: "agent", text: "An agent acting for a customer", checked: applicant == "agent" }
          ]
        }) }}
        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
